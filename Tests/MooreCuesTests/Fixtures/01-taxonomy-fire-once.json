{
  "fixture": "01-taxonomy-fire-once",
  "contractId": "SC-cues@1.0.0",
  "cites": "BR-001, BR-002, BR-003, INV-C3, INV-C5, INV-C7 — each of the eight cues fires exactly once per lifecycle event with the exact §3(a) channel descriptor",
  "vectors": [
