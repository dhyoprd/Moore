  "exercises": [{ "id": "ex-bench", "name": "Barbell Bench Press" }],
  "routine": {
    "id": "rt-a",
    "name": "Push A",
    "sets": [
      { "exerciseId": "ex-bench", "plannedWeight": 60, "plannedReps": 8, "plannedDuration": null, "setClass": "work" },
      { "exerciseId": "ex-bench", "plannedWeight": 60, "plannedReps": 8, "plannedDuration": null, "setClass": "work" }
    ]
  },
  "actions": [
    { "type": "materialize" },
    { "type": "drop", "setIndex": 0 },
    { "type": "accept", "setIndex": 1 },
    { "type": "undoDrop", "setIndex": 0, "expectFailure": true }
